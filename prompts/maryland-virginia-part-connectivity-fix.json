  "zero_population_context": {
    "schema_version": 1,
    "checked_at_utc": "2026-10-23T16:26:37.571554+00:00",
    "purpose": "Read-only source-field investigation of the two multipart blocks responsible for the Maryland K19 and Virginia K26 polygon failures.",
    "conclusion": "Zero published population is not itself evidence of a data error or protected land. The two source blocks have different characteristics: Maryland is land with one housing unit, Virginia is mostly water with no housing units. The demonstrated connectivity defect was our one-node-per-multipart-block model, not a demonstrated Census data error.",
    "general_context": [
      "Census blocks cover all territory and are delineated from visible and nonvisible boundaries rather than population; many have no population.",
      "MTFCC20=G5040 means tabulation block, not a land-use, park, protection, or ownership classification. Both records have UR20=R (rural).",
      "The source attribute metadata explicitly labels POP20 as the 2020 Census population count adjusted by the Disclosure Avoidance System. A published zero is therefore not a forensic guarantee that a place had no residents, and we have not established whether privacy protection changed either block count.",
      "Census housing-unit totals are held invariant at block level. A housing unit with no usual residents, including a seasonal unit whose occupants usually live elsewhere, can coexist with zero resident population; this is a possible Maryland interpretation, not a verified occupancy finding.",
      "Multipart geometry exists in these preserved Census source polygons. Its existence alone is not evidence of bad data. We have not verified the geographic reason for the two blocks being multipart or identified any parcel protection status."
    ],
    "source_attribute_definitions": {
      "MTFCC20": "MAF/TIGER feature class code",
      "UR20": "2020 Census urban/rural indicator",
      "ALAND20": "2020 Census land area (square meters)",
      "AWATER20": "2020 Census water area (square meters)",
      "HOUSING20": "2020 Census Housing Unit Count",
      "POP20": "2020 Census Population Count Adjusted By Disclosure Avoidance System (DAS)"
    },
