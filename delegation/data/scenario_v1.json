  "ballot_papers": [
    {
      "id": "city-general",
      "title": "City general ballot",
      "jurisdiction": "city",
      "questions": [
        {
          "id": "q01",
          "title": "Senior property tax freeze",
          "summary": "Freezes the assessed home value used for property tax for homeowners aged 65 and over with household income under $60,000."
        },
        {
          "id": "q03",
          "title": "Half-cent sales tax increase",
          "summary": "Raises the city sales tax rate from 8.0 to 8.5 percent."
        },
        {
          "id": "q10",
          "title": "Sister-city grant for Amazon amphibian habitat",
          "summary": "Gives $150,000 to a partner city in Brazil to protect tree frog breeding habitat in the Amazon basin."
        },
        {
          "id": "q12",
          "title": "Street tree planting bond",
          "summary": "Borrows $12 million to plant and maintain 20,000 street trees."
        },
        {
          "id": "q16",
          "title": "Wetland restoration for stormwater",
          "summary": "Restores 40 acres of wetland to absorb stormwater and reduce flooding."
        },
        {
          "id": "q19",
          "title": "Free school breakfast and lunch",
          "summary": "Provides free breakfast and lunch to every student in the public schools."
        },
        {
          "id": "q21",
          "title": "School construction bond",
          "summary": "Borrows $85 million to rebuild two elementary schools and repair school roofs across the district."
        },
        {
          "id": "q26",
          "title": "Annual rent increase cap",
          "summary": "Limits rent increases to 5 percent a year in buildings more than 15 years old."
        },
        {
          "id": "q32",
          "title": "Transit-oriented development fund",
          "summary": "Uses transit agency land next to stations for new housing and pays for better access to the stations."
        },
        {
          "id": "q33",
          "title": "Protected bike lane network",
          "summary": "Builds 25 miles of protected bike lanes on major streets."
        },
        {
          "id": "q39",
          "title": "Civilian police review board",
          "summary": "Creates an elected civilian board with the power to investigate complaints against police officers."
        },
        {
          "id": "q45",
          "title": "Paid sick leave",
          "summary": "Requires employers to provide one hour of paid sick leave for every 30 hours worked."
        },
        {
          "id": "q48",
          "title": "Raise the minimum wage",
          "summary": "Raises the city minimum wage to $19 an hour, then ties it to inflation."
        },
        {
          "id": "q52",
          "title": "Ranked choice voting for city offices",
          "summary": "Uses ranked choice voting to elect the mayor and city council starting next year."
        },
        {
          "id": "q66",
          "title": "New city flag",
          "summary": "Adopts a new design for the official city flag."
        }
      ]
    },
    {
      "id": "district-2-special",
      "title": "District 2 special ballot",
      "jurisdiction": "district-2",
      "questions": [
        {
          "id": "q28",
          "title": "Downtown height limit increase",
          "summary": "Raises the maximum building height downtown from 6 to 12 stories."
        },
        {
          "id": "q34",
          "title": "Bike lane on Main Street",
          "summary": "Removes one car lane on Main Street to add a two-way protected bike lane."
        },
        {
          "id": "q41",
          "title": "New fire station",
          "summary": "Builds and staffs a new fire station in the north end."
        },
        {
          "id": "q57",
          "title": "New waterfront park",
          "summary": "Converts a former shipping pier into a 9-acre public park."
        },
        {
          "id": "q64",
          "title": "Late-night noise limits",
          "summary": "Lowers the allowed noise level for bars and music venues after 11 p.m."
        }
      ]
    }
  ],
