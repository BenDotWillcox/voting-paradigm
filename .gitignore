# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
venv/
__pycache__/
.pytest_cache/
*.pyc
.cache/
.figures.json.tmp

# Keep machine-local Claude state ignored while publishing project review skills.
.claude/*
!.claude/skills/
!.claude/skills/**

# Private human preference-evaluation records. Public artifacts must be
# generated separately without raw responses or direct identifiers.
/eval/private_runs/

# Exact Phase 3B packets, retest variants, and restricted review logs remain
# local until every planned blinded evaluation and retest is complete.
/eval/restricted_bank/

# Raw districting algorithm artifacts (tract-level GeoJSON, ~5 GB total).
# The display artifacts the site actually serves are derived from these via
# scripts/build_district_topojson.py into districting-topo/ and
# districting-summary/.
/public/data/districting/

# Block-plan display assets (~4.7 GB, 510k content-addressed files) and the
# server allowlist (~270 MB) are regenerated by `npm run prepare:block-plans`
# and published to object storage. Only the browser manifest and the build
# reports are tracked.
/data/districting-block-plans/*
!/data/districting-block-plans/manifest.json
!/data/districting-block-plans/*-report.json
